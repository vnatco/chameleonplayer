{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Chameleon Player",
  "mainBinaryName": "chameleon",
  "version": "0.1.0",
  "identifier": "co.vnat.chameleon",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Chameleon Player",
        "width": 860,
        "height": 860,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "resizable": false,
        "visible": false,
        "center": true,
        "dragDropEnabled": true,
        "skipTaskbar": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "img-src": "'self' asset: http://asset.localhost data: blob: https://coverartarchive.org https://*.archive.org",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self' data:",
        "connect-src": "ipc: http://ipc.localhost"
      },
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "category": "Music",
    "shortDescription": "Cover-first, chameleon music player",
    "license": "Apache-2.0",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}